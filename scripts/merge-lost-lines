#!/usr/bin/env python3
"""merge-lost-lines [--base BASE] [--last N] [--self-test] [MERGE...]

For a merge M (default: every first-parent merge in the last N, default 1), list the lines M REMOVED relative to its
first parent P that another commit added after BASE (default: the first parent N+20 merges before M). `merge-integrity`
only sees test function names; a merge that reapplies old file blobs also drops non-test hunks of other cards, and
this script finds those (2026-10-23: the POOT-1244 merge reverted POOT-1323 in 15 files).

A line counts as lost when, in `git diff P M --no-renames -U0`, it is a removed line (non-blank, over 3 characters,
not pure punctuation), `git blame P` attributes it to a commit in BASE..P, and the same stripped text is not added by
M anywhere (moved code matches by line text and multiplicity, reflowed code by its whitespace-free text).

Output is grouped by file, then by the card (POOT-NNNN in the introducing commit's subject or its merge). Exit 1 when
any lost line is found. Run from the poot repo."""
import collections
import re
import subprocess
import sys
import tempfile


REPO = None  # the repository to inspect; None is the current directory


def git(*a, cwd=None):
    return subprocess.run(["git", *a], capture_output=True, text=True, check=True, cwd=cwd or REPO).stdout


def significant(text):
    s = text.strip()
    return len(s) > 3 and not re.fullmatch(r"[\W_]+", s)


def parse_removed(diff):
    """{path: [(old_line_no, text)]}, a Counter of stripped added texts, and all added text with whitespace removed."""
    removed, added = collections.defaultdict(list), collections.Counter()
    squeezed = []
    path, old_no = None, 0
    for line in diff.splitlines():
        if line.startswith("--- "):
            path = None if line == "--- /dev/null" else line[6:]
        elif line.startswith("+++ "):
            continue
        elif line.startswith("@@"):
            old_no = int(re.match(r"@@ -(\d+)", line).group(1))
        elif line.startswith("-"):
            if path and significant(line[1:]):
                removed[path].append((old_no, line[1:]))
            old_no += 1
        elif line.startswith("+"):
            if significant(line[1:]):
                added[line[1:].strip()] += 1
                squeezed.append(re.sub(r"\s+", "", line))
    return removed, added, "".join(squeezed)


def card_of(commit, memo):
    if commit not in memo:
        subject = git("log", "-1", "--format=%s", commit).strip()
        found = re.findall(r"POOT-\d+[a-z]?", subject)
        memo[commit] = (found[-1] if found else "no card", subject[:70])
    return memo[commit]


def lost_lines(merge, base):
    parent = git("rev-parse", f"{merge}^1").strip()
    removed, added, added_blob = parse_removed(git("diff", "--no-renames", "-U0", parent, merge))
    since = set(git("rev-list", f"{base}..{parent}").split())
    memo, report = {}, collections.defaultdict(lambda: collections.defaultdict(list))
    for path, lines in removed.items():
        blame = git("blame", "--line-porcelain", parent, "--", path).splitlines()
        owner = {}
        for i, row in enumerate(blame):
            m = re.match(r"^([0-9a-f]{40}) \d+ (\d+)", row)
            if m:
                owner[int(m.group(2))] = m.group(1)
        for no, text in lines:
            commit = owner.get(no)
            if commit not in since:
                continue
            if added[text.strip()] > 0:
                added[text.strip()] -= 1
                continue
            squeezed = re.sub(r"\s+", "", text)
            if len(squeezed) >= 12 and squeezed in added_blob:  # reflowed (an import list, a wrapped call)
                continue
            report[path][card_of(commit, memo)].append((no, text.strip()))
    return report


def main(argv):
    base, last, merges = None, 1, []
    i = 0
    while i < len(argv):
        if argv[i] == "--base":
            base = argv[i + 1]
            i += 1
        elif argv[i] == "--last":
            last = int(argv[i + 1])
            i += 1
        elif argv[i] == "--self-test":
            return self_test()
        else:
            merges.append(argv[i])
        i += 1
    if not merges:
        merges = git("log", "--merges", "--first-parent", f"-{last}", "--format=%h").split()
    bad = 0
    for m in merges:
        floor = base or git("log", "--merges", "--first-parent", "--skip=30", "-1", "--format=%h", f"{m}^1").strip()
        floor = floor or git("rev-list", "--max-parents=0", m).split()[0]
        report = lost_lines(m, floor)
        subject = git("log", "-1", "--format=%s", m).strip()[:70]
        total = sum(len(v) for cards in report.values() for v in cards.values())
        if not total:
            print(f"ok      {m} {subject}")
            continue
        bad += 1
        print(f"LOST    {m} {subject}: {total} removed lines another commit added since {floor}")
        for path in sorted(report):
            for (card, subj), rows in sorted(report[path].items()):
                print(f"  {path}: {len(rows)} line(s) from {card} ({subj})")
                for no, text in rows[:3]:
                    print(f"      {no}: {text[:110]}")
    return 1 if bad else 0


def self_test():
    global REPO
    with tempfile.TemporaryDirectory() as d:
        REPO = d
        def g(*a):
            return git("-c", "user.name=t", "-c", "user.email=t@t", *a)

        g("init", "-q", "-b", "master")
        open(f"{d}/f.rs", "w").write("fn a() {}\nfn keep_me_one() {}\n")
        g("add", "."), g("commit", "-qm", "base")
        base = g("rev-parse", "HEAD").strip()
        g("checkout", "-qb", "old")
        open(f"{d}/f.rs", "w").write("fn a() {}\nfn keep_me_one() {}\nfn old_side() {}\n")
        g("commit", "-qam", "old side")
        g("checkout", "-q", "master")
        g("checkout", "-qb", "card1323")
        open(f"{d}/f.rs", "w").write("fn a() {}\nfn keep_me_one() {}\nfn the_lost_hunk() {}\n")
        g("commit", "-qam", "POOT-1323: add the hunk")
        g("checkout", "-q", "master"), g("merge", "-q", "--no-ff", "-m", "Merge card/1323 (POOT-1323)", "card1323")
        g("checkout", "-qb", "card1244", base)
        open(f"{d}/f.rs", "w").write("fn a() {}\nfn keep_me_one() {}\nfn unrelated_1244() {}\n")
        g("commit", "-qam", "POOT-1244: old blob")
        g("checkout", "-q", "master"), g("merge", "-q", "--no-ff", "-X", "theirs", "-m", "Merge card/1244", "card1244")
        report = lost_lines(g("rev-parse", "HEAD").strip(), base)
        flat = [t for cards in report.values() for rows in cards.values() for _, t in rows]
        assert flat == ["fn the_lost_hunk() {}"], flat
        assert ("POOT-1323", "POOT-1323: add the hunk") in report["f.rs"], dict(report["f.rs"])
        print("merge-lost-lines self-test ok: the dropped hunk is found and attributed to its card")
    return 0


sys.exit(main(sys.argv[1:]))
