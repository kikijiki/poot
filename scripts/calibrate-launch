#!/usr/bin/env bash
# calibrate-launch: fit the contraction cost model's ratios to this device's measured time and write a PerfCalibration
# cost entry for review (design POOT-1479 section 3.4). One process per measurement (an HSA executor cannot be reopened
# in a process); the whole batch holds the GPU lock and the heavy lock once, GPU lock first.
#
#   scripts/calibrate-launch rocm|wgpu tilings [out-dir]   the LDS-read and staged-value ratios, over every candidate
#                                                          tiling of a dense corpus (POOT-1494)
#   scripts/calibrate-launch rocm|wgpu indexed [out-dir]   the Gemv's direct-value and global-byte ratios, over the Gemv
#                                                          and the grouped tiling of an indexed corpus (POOT-1489), and
#                                                          the table of the production planner's choice against the
#                                                          retired 32-row switch
#   scripts/calibrate-launch rocm|wgpu packed [out-dir]    every tiling of a routed projection over a packed expert stack
#                                                          (a packed_grouped_experts bank case) at 128, 512 and 2048
#                                                          tokens, exact and narrow, and the per-row Gemv, one row each
#                                                          with the dispatches timed one by one (POOT-1505, POOT-1547)
#   scripts/calibrate-launch rocm|wgpu dense [out-dir]     the same rows for dense prefill projections and one-row
#                                                          vocabulary-head decodes (POOT-1547)
#   scripts/calibrate-launch rocm fragment [out-dir]       both packed cases (IQ2_XS up, IQ4_NL down) and the dense
#                                                          cells in one hold: the rows benchmarks/calibration/<device>.tsv
#                                                          is made of, which fit_fragment_cost.py there fits
#   scripts/calibrate-launch rocm heldout [out-dir]        both Q4_K packed cases (up and down), the rows
#                                                          benchmarks/calibration/<device>-heldout-q4k.tsv is made of, which
#                                                          fit_fragment_cost.py --heldout scores without fitting (POOT-1565)
#   scripts/calibrate-launch rocm|wgpu|ptx gemv [out-dir]  the dense decode Gemv's columns per workgroup, every power of
#                                                          two up to 16 pinned over output counts from a launch that
#                                                          starves the device to one that floods it (POOT-1490)
#   scripts/calibrate-launch rocm|wgpu|ptx packedgemv [out-dir]
#                                                          the packed decode Gemv's launch geometry (cols, rows, run,
#                                                          depth) pinned over 27B projection shapes of Q4_K, Q5_K, IQ4_XS,
#                                                          Q6_K and Q8_0, the weights rotated beyond the last-level cache;
#                                                          rows.tsv is what benchmarks/calibration/fit_packed_gemv.py
#                                                          fits (POOT-1608)
#
# CALIBRATE_LAUNCH_BIN names a prebuilt example binary (the script then builds nothing), and CALIBRATE_LAUNCH_LOCKED=1
# says the caller already holds the GPU lock and the heavy lock (gpu first), so one hold can cover several runs.
set -euo pipefail
backend="${1:?usage: calibrate-launch rocm|wgpu|ptx tilings|indexed|gemv|packedgemv|packed|dense|fragment|heldout [out-dir]}"
mode="${2:?usage: calibrate-launch rocm|wgpu|ptx tilings|indexed|gemv|packedgemv|packed|dense|fragment|heldout [out-dir]}"
out="${3:-calibrate-launch-$backend-$mode}"
mkdir -p "$out"
root="$(cd "$(dirname "$0")/.." && pwd)"
bank="$root/benchmarks/performance-bank/cases.json"
if [ -z "${CALIBRATE_LAUNCH_BIN:-}" ]; then
  cargo build --release -p "poot-$backend-device" --example calibrate_launch
fi
bin="${CALIBRATE_LAUNCH_BIN:-${CARGO_TARGET_DIR:-$root/target}/release/examples/calibrate_launch}"
device="${POOT_BANK_DEVICE:-$backend}"
rows="$out/rows.tsv"
: >"$rows"
if [ -z "${CALIBRATE_LAUNCH_LOCKED:-}" ]; then
  exec 9>/tmp/poot-gpu.lock
  flock 9
  exec 8>/tmp/poot-heavy.lock
  flock 8
fi
case "$mode" in
tilings)
  "$bin" shapes >"$out/tilings.tsv"
  while IFS=$'\t' read -r shape tiling; do
    "$bin" measure --bank "$bank" --shape "$shape" --tiling "$tiling" >>"$rows"
  done <"$out/tilings.tsv"
  "$bin" fit --rows "$rows" --out "$out/entry.rs" --device "$device"
  ;;
indexed)
  "$bin" indexed-cells >"$out/cells.tsv"
  while read -r cell; do
    for pin in gemv grouped; do
      "$bin" indexed-measure --bank "$bank" --cell "$cell" --rows "$pin" >>"$rows"
    done
  done <"$out/cells.tsv"
  "$bin" indexed-choice >"$out/choices.tsv"
  "$bin" indexed-fit --rows "$rows" --choices "$out/choices.tsv" --out "$out/entry.rs"
  ;;
packed)
  # CALIBRATE_LAUNCH_CASE names the packed_grouped_experts bank case (default: the IQ2_XS expert up projection).
  case_id="${CALIBRATE_LAUNCH_CASE:-expert-prefill-packed-iq2xs-up}"
  "$bin" packed-cells --bank "$bank" --case "$case_id" >"$out/cells.tsv"
  while IFS=$'\t' read -r tokens precision tiling; do
    "$bin" packed-measure --bank "$bank" --case "$case_id" --tokens "$tokens" --precision "$precision" --tiling "$tiling" >>"$rows"
  done <"$out/cells.tsv"
  ;;
dense)
  "$bin" dense-cells --bank "$bank" >"$out/cells.tsv"
  while IFS=$'\t' read -r shape precision tiling; do
    "$bin" dense-measure --bank "$bank" --shape "$shape" --precision "$precision" --tiling "$tiling" >>"$rows"
  done <"$out/cells.tsv"
  ;;
fragment)
  # The corpus of POOT-1547: the packed cases and the dense cells, one hold. The committed file adds the cell, K and
  # the rows to each of these rows (see its header).
  for case_id in expert-prefill-packed-iq2xs-up expert-prefill-packed-iq4nl-down; do
    CALIBRATE_LAUNCH_CASE="$case_id" CALIBRATE_LAUNCH_BIN="$bin" CALIBRATE_LAUNCH_LOCKED=1 "$0" "$backend" packed "$out/$case_id"
  done
  CALIBRATE_LAUNCH_BIN="$bin" CALIBRATE_LAUNCH_LOCKED=1 "$0" "$backend" dense "$out/dense"
  echo "rows are in $out/*/rows.tsv; join them into benchmarks/calibration/<device>.tsv and run" >&2
  echo "python3 -I benchmarks/calibration/fit_fragment_cost.py --check" >&2
  ;;
heldout)
  # The held-out corpus of POOT-1565: a packed format the fit of `fragment` does not hold, one hold.
  for case_id in expert-prefill-packed-q4k-up expert-prefill-packed-q4k-down; do
    CALIBRATE_LAUNCH_CASE="$case_id" CALIBRATE_LAUNCH_BIN="$bin" CALIBRATE_LAUNCH_LOCKED=1 "$0" "$backend" packed "$out/$case_id"
  done
  echo "rows are in $out/*/rows.tsv; join them into benchmarks/calibration/<device>-heldout-q4k.tsv and run" >&2
  echo "python3 -I benchmarks/calibration/fit_fragment_cost.py --heldout benchmarks/calibration/<device>-heldout-q4k.tsv" >&2
  ;;
gemv)
  "$bin" gemv-cells >"$out/cells.tsv"
  while IFS=$'\t' read -r cell cols; do
    "$bin" gemv-measure --bank "$bank" --cell "$cell" --cols "$cols" >>"$rows"
  done <"$out/cells.tsv"
  "$bin" gemv-fit --rows "$rows" --out "$out/entry.rs"
  ;;
packedgemv)
  # One process per geometry. A geometry the compile refuses is recorded in failed.tsv and skipped, so one refusal does
  # not end a pod hold; the fit reads rows.tsv alone.
  #
  # CALIBRATE_LAUNCH_PTXAS (POOT-1610) names `ptxas`:
  # every measured geometry gets a kernel cache of its own, and the Gemv kernel's registers and spill bytes in that
  # cache's PTX, as ptxas reports them for CALIBRATE_LAUNCH_ARCH (sm_120), are one row of registers.tsv
  # (`format NxK cols rows run depth registers spill_bytes`). CALIBRATE_LAUNCH_REPEAT_CELLS lists cells
  # (`format:NxK`, space separated) whose run-16 geometries are measured twice more after the sweep, in the order
  # given and then the reverse, into repeats.tsv (`pass` as the first column): the run-to-run spread.
  "$bin" packed-gemv-cells --bank "$bank" >"$out/cells.tsv"
  # CALIBRATE_LAUNCH_ONLY_CELLS (`format:NxK`, space separated) keeps those cells of the corpus alone: the cells added to a
  # corpus another hold measured (POOT-1611).
  if [ -n "${CALIBRATE_LAUNCH_ONLY_CELLS:-}" ]; then
    awk -F'\t' -v only="$CALIBRATE_LAUNCH_ONLY_CELLS" 'BEGIN { n = split(only, a, " "); for (i = 1; i <= n; i++) keep[a[i]] = 1 } keep[$1 ":" $2]' "$out/cells.tsv" >"$out/cells.only" && mv "$out/cells.only" "$out/cells.tsv"
  fi
  : >"$out/failed.tsv"
  registers="$out/registers.tsv"
  : >"$registers"
  # The Gemv kernel of a geometry's cache: its PTX (a cache file is a header, then the text from "// Generated by
  # LLVM") through ptxas, one row `format NxK cols rows run depth registers spill_bytes` (`spill_bytes` the stores).
  # A cache without exactly one packed_contraction kernel is the row `NA`, never a guess.
  registers_of() { # cache format cell cols rows run depth
    local cache="$1" ptx="$1.ptx" found=() file offset entry report n_regs n_spill
    while IFS= read -r file; do
      offset="$(grep -abo '// Generated by LLVM' "$file" | head -1 | cut -d: -f1)"
      [ -n "$offset" ] || continue
      tail -c +$((offset + 1)) "$file" >"$ptx"
      entry="$(grep -m1 -o '\.entry [A-Za-z0-9_]*' "$ptx" | cut -d' ' -f2)"
      case "$entry" in packed_contraction) found+=("$ptx.$entry"); cp "$ptx" "$ptx.$entry" ;; esac
    done < <(find "$cache" -type f -name '*.ptx')
    if [ "${#found[@]}" -ne 1 ]; then
      printf '%s\t%s\t%s\t%s\t%s\t%s\tNA\tNA\n' "$2" "$3" "$4" "$5" "$6" "$7"
      echo "registers: $cache holds ${#found[@]} packed_contraction kernels" >&2
    else
      report="$("$CALIBRATE_LAUNCH_PTXAS" -arch="${CALIBRATE_LAUNCH_ARCH:?CALIBRATE_LAUNCH_ARCH}" -v -o /dev/null "${found[0]}" 2>&1)"
      n_regs="$(sed -n 's/.*Used \([0-9]*\) registers.*/\1/p' <<<"$report" | head -1)"
      n_spill="$(sed -n 's/.* \([0-9]*\) bytes spill stores.*/\1/p' <<<"$report" | head -1)"
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$2" "$3" "$4" "$5" "$6" "$7" "${n_regs:?ptxas reported no registers: $report}" "${n_spill:-0}"
    fi
    rm -f "$ptx" "$ptx".*
  }
  measure_one() { # format cell cols rows run depth: one row of rows.tsv (or the repeats) on stdout
    "$bin" packed-gemv-measure --bank "$bank" --format "$1" --cell "$2" --cols "$3" --rows "$4" --run "$5" --depth "$6"
  }
  while IFS=$'\t' read -r format cell cols rows_ run depth; do
    cache="$out/kernel-cache/$format-$cell-$cols-$rows_-$run-$depth"
    if [ -n "${CALIBRATE_LAUNCH_PTXAS:-}" ]; then
      rm -rf "$cache"
      POOT_KERNEL_CACHE_DIR="$cache" measure_one "$format" "$cell" "$cols" "$rows_" "$run" "$depth" >>"$rows"
    else
      measure_one "$format" "$cell" "$cols" "$rows_" "$run" "$depth" >>"$rows"
    fi || { printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$format" "$cell" "$cols" "$rows_" "$run" "$depth" >>"$out/failed.tsv"; continue; }
    if [ -n "${CALIBRATE_LAUNCH_PTXAS:-}" ]; then
      registers_of "$cache" "$format" "$cell" "$cols" "$rows_" "$run" "$depth" >>"$registers"
      rm -rf "$cache"
    fi
  done <"$out/cells.tsv"
  if [ -n "${CALIBRATE_LAUNCH_REPEAT_CELLS:-}" ]; then
    : >"$out/repeats.tsv"
    read -r -a repeat_cells <<<"$CALIBRATE_LAUNCH_REPEAT_CELLS"
    reversed=()
    for ((i = ${#repeat_cells[@]} - 1; i >= 0; i--)); do reversed+=("${repeat_cells[i]}"); done
    pass=1
    for order in "${repeat_cells[@]}" "-" "${reversed[@]}"; do
      if [ "$order" = "-" ]; then pass=2; continue; fi
      while IFS=$'\t' read -r format cell cols rows_ run depth; do
        [ "$format:$cell" = "$order" ] && [ "$run" = 16 ] || continue
        if row="$(measure_one "$format" "$cell" "$cols" "$rows_" "$run" "$depth")"; then
          printf '%s\t%s\n' "$pass" "$row" >>"$out/repeats.tsv"
        fi
      done <"$out/cells.tsv"
    done
  fi
  echo "rows are in $rows ($(wc -l <"$rows") of $(wc -l <"$out/cells.tsv") cells; refused: $(wc -l <"$out/failed.tsv")); fit with" >&2
  echo "python3 -I benchmarks/calibration/fit_packed_gemv.py $rows" >&2
  ;;
*)
  echo "usage: calibrate-launch rocm|wgpu|ptx tilings|indexed|gemv|packedgemv|packed|dense|fragment|heldout [out-dir]" >&2
  exit 2
  ;;
esac
