{
  "schema": 1,
  "description": "The small performance bank. Each case is one shape/storage/numerics point a backend runner (examples/performance_bank.rs in poot-gpu, poot-rocm-gpu, poot-ptx-gpu) measures through the executor contract. Identities are stamped by `python3 benchmarks/harness/performance_bank.py --stamp` and verified by `python3 benchmarks/harness/performance_bank.py`.",
  "timing_policy": {
    "warmup": 3,
    "repeats": 9,
    "clock": "wall step plus readback",
    "profiled": false
  },
  "token_fixtures": {
    "splitmix64-seed0-unit": {
      "generator": "splitmix64",
      "seed": 0,
      "distribution": "uniform f32 in [-1, 1) from the top 24 bits of each draw",
      "streams": "activation x, then weight w, then (attention) k and v, in that order"
    }
  },
  "cache_conditions": {
    "weights-rotated-beyond-cache": {
      "kind": "weight-rotation",
      "min_rotation_bytes": 268435456,
      "rule": "weights are held as ceil(min_rotation_bytes / weight_bytes) distinct copies and consecutive steps use consecutive copies, so a step never finds its weights in the last-level cache"
    },
    "weights-resident-hot": {
      "kind": "single-copy",
      "rule": "one weight copy reused by every step; the working set fits the last-level cache whenever the device has one that large"
    }
  },
