# harness venv + build artifacts. uv.lock and Cargo.lock are committed (they pin exact versions).
.venv/
__pycache__/
*.pyc
runners/*/target/
# model artifacts (GGUF conversions, downloaded checkpoints)
*.gguf
models/

# orchestrator local run-state (SQLite db + logs)
.orchestrator/

# in-progress mirrors of a set the orchestrator is sweeping (see bench.PARTIAL_SUFFIX)
results/*.partial/

# sets with no ok row (see poot-orchestrator gather::failed_dir)
failed-results/
