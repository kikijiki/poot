# harness venv + build artifacts. uv.lock and Cargo.lock are committed (they pin exact versions).
.venv/
__pycache__/
*.pyc
runners/*/target/
# model artifacts (GGUF conversions, downloaded checkpoints)
*.gguf
models/

# orchestrator local run-state (SQLite db + logs)
.orchestrator/

# the default recording root of a run (see harness/results_root.py): the committed sets live in the results archive
results/
# the bank's measured output, when a run records beside the default results root
performance-bank/receipts/
performance-bank/receipts.json
performance-bank/ceilings/

# sets with no ok row (see poot-orchestrator gather::failed_dir)
failed-results/
